# Copy this file to .env and fill in real values from your Entra ID app registrations.
# Get these from https://entra.microsoft.com → App registrations → Task Tracker API / SPA
TENANT_ID=00000000-0000-0000-0000-000000000000
API_CLIENT_ID=00000000-0000-0000-0000-000000000000
API_CLIENT_SECRET=replace-with-secret-value-from-certificates-and-secrets-page
SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000
API_SCOPE_NAME=access_as_user

# Microsoft Dataverse — only needed if backend/app/main.py imports `dataverse as store`.
# Find your env URL at https://admin.powerplatform.microsoft.com → Environments → Organization URL
DATAVERSE_URL=https://orgXXXXXXXX.crm.dynamics.com
DATAVERSE_TABLE=cr0b4_tasks

ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
